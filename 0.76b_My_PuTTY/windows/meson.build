################################################################################
# Ejecutables
################################################################################
# putty.exe llevaba objetos *_integrated de pageant.c, windows/pageant.c y
# windows/puttygen.c: el agente y el generador de claves van embebidos. Como
# nunca coexisten con sus versiones normales dentro del mismo binario (se
# verificó), basta con definir los MOD_INTEGRATED_* para todo el target en vez
# de duplicar objetos.

common_deps = [
  base64_dep,
  bcrypt_dep,
  mini_dep,
  posix_regex_dep,
] + win_libs

executable(
  'kitty',
  src_putty + [res_putty, kitty_ini_h, kitty_help_h],
  c_args: ['-DMOD_INTEGRATED_AGENT', '-DMOD_INTEGRATED_KEYGEN'],
  include_directories: putty_inc,
  dependencies: common_deps + [libjpeg_dep, blocnote_dep],
  win_subsystem: 'windows',
  name_suffix: 'exe',
  install: false,
)

executable(
  'klink',
  src_plink + [res_plink],
  include_directories: putty_inc,
  dependencies: common_deps,
  link_whole: plink_variants,
  win_subsystem: 'console',
  name_suffix: 'exe',
  install: false,
)

executable(
  'kscp',
  src_pscp + [res_pscp],
  include_directories: putty_inc,
  dependencies: common_deps,
  win_subsystem: 'console',
  name_suffix: 'exe',
  install: false,
)

executable(
  'ksftp',
  src_psftp + [res_psftp],
  include_directories: putty_inc,
  dependencies: common_deps,
  win_subsystem: 'console',
  name_suffix: 'exe',
  install: false,
)

executable(
  'kageant',
  src_pageant + [res_pageant],
  include_directories: putty_inc,
  dependencies: common_deps,
  win_subsystem: 'windows',
  name_suffix: 'exe',
  install: false,
)

executable(
  'kittygen',
  src_puttygen + [res_puttygen],
  include_directories: putty_inc,
  dependencies: common_deps,
  win_subsystem: 'windows',
  name_suffix: 'exe',
  install: false,
)
