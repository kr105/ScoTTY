# Los seis ejecutables de ScoTTY.
#
# Las listas de fuentes se extrajeron ejecutando `make -n` sobre cada target del
# MAKEFILE.MINGW anterior y parseando las líneas de compilación, no a ojo. Son
# 183 ficheros .c únicos repartidos entre 0.76b_My_PuTTY/, la raíz del repo y
# adb/, far2l/, url/ y zmodem/.
#
# No se agrupan en una static library común a propósito. PuTTY usa el patrón
# "stubs": varios ficheros definen el mismo símbolo con implementaciones
# distintas (noterm.c frente a terminal.c, nogss.c frente a gssc.c, norand.c...)
# y cada ejecutable elige los suyos. Metidos en un archivo compartido, el
# enlazador extraería el stub equivocado según el orden. Las listas explícitas
# reproducen exactamente la semántica del build anterior y, de paso, dejan por
# escrito qué entra en cada binario.

windows_mod = import('windows')

################################################################################
# Recursos
################################################################################
# windres resuelve las rutas relativas de los ICON (../../res/x.ico) contra las
# rutas de include, así que putty_inc basta para encontrarlas.

rc_args = [
  '--define', 'WIN32=1',
  '--define', '_WIN32=1',
  '--define', 'WINVER=0x0400',
  '-DMOD_PERSO',
  '-DFLJ1',
]

# Cabeceras y fragmentos que incluyen los .rc. Meson no los deduce solo, así
# que se listan para que un cambio en ellos rehaga el recurso.
rc_depends = files(
  'help.rc2',
  'putty-common.rc2',
  'putty-rc.h',
  'rcstuff.h',
  'version.rc2',
)

res_putty = windows_mod.compile_resources(
  'putty.rc',
  args: rc_args + ['-DMOD_INTEGRATED_AGENT', '-DMOD_INTEGRATED_KEYGEN'],
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

res_plink = windows_mod.compile_resources(
  'plink.rc',
  args: rc_args,
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

res_pscp = windows_mod.compile_resources(
  'pscp.rc',
  args: rc_args,
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

res_psftp = windows_mod.compile_resources(
  'psftp.rc',
  args: rc_args,
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

res_pageant = windows_mod.compile_resources(
  'pageant.rc',
  args: rc_args,
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

res_puttygen = windows_mod.compile_resources(
  'puttygen.rc',
  args: rc_args + ['-DMOD_INTEGRATED_KEYGEN'],
  include_directories: putty_inc,
  depend_files: rc_depends + [version_h],
)

################################################################################
# Variantes de plink
################################################################################
# plink compilaba be_all_s.c y ldisc.c con un CFLAGS_PLINK propio que divergía
# del general en 25 defines. Revisados uno a uno contra el código, solo dos
# tienen efecto en esos ficheros: MOD_ADB en be_all_s.c y MOD_RUTTY en ldisc.c.
# El resto de la divergencia era deriva del makefile, no intención. El
# -DNO_MOD_RUTTY que también pasaba no se consulta en ninguna parte del repo.

plink_variants = static_library(
  'plink_variants',
  files('../be_all_s.c', '../ldisc.c'),
  c_args: ['-UMOD_ADB', '-UMOD_RUTTY'],
  include_directories: putty_inc,
)

################################################################################
# Fuentes
################################################################################

