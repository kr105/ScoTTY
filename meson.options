option(
  'master_password',
  type: 'string',
  value: 'ToBeDefined',
  description: 'Clave de ofuscación de contraseñas guardadas (antes masterpassword.txt). ' +
               'Es una constante de compilación, no un secreto: cualquiera con el binario puede extraerla.',
)

option(
  'source_date_epoch',
  type: 'string',
  value: '',
  description: 'Marca de tiempo UNIX fija para builds reproducibles. ' +
               'Vacío = se toma de $SOURCE_DATE_EPOCH y, si no, de la fecha del último commit.',
)

option(
  'background_image',
  type: 'boolean',
  value: true,
  description: 'Imagen de fondo del terminal y capturas de pantalla en JPEG. ' +
               'Es la única razón por la que un cliente SSH acaba enlazando ' +
               'libjpeg; desactivarla elimina esa dependencia por completo.',
)

option(
  'tests',
  type: 'boolean',
  value: true,
  description: 'Compila y registra los tests que corren en el host (no cross).',
)
